{
  "name": "ts-nextjs-tailwind-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS='--inspect' next dev --webpack",
    "build": "next build --webpack",
    "build:mainland": "cross-env NEXT_PUBLIC_IMAGE_BASE_URL= NEXT_PUBLIC_UPYUN_IMAGE_BASE_URL=https://img.hellogithub.com yarn build",
    "build:overseas": "cross-env NEXT_PUBLIC_IMAGE_BASE_URL=https://img-global.cheatsheet.store NEXT_PUBLIC_UPYUN_IMAGE_BASE_URL=https://img.hellogithub.com yarn build",
    "build:dep": "cross-env ANALYZE=true next build --webpack",
    "start": "next start",
    "server_start": "pm2 start ecosystem.config.js",
    "server_reload": "yarn build:mainland && pm2 reload ecosystem.config.js",
    "server_reload:hw": "yarn build:overseas && pm2 reload ecosystem.config.js",
    "server_stop": "pm2 stop ecosystem.config.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && yarn format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "release": "standard-version",
    "push-release": "git push --follow-tags origin main",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@next/bundle-analyzer": "16.4.3",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "copy-to-clipboard": "^4.0.2",
    "dayjs": "^1.11.23",
    "express": "^5.3.0",
    "i18next": "^26.5.12",
    "js-cookie": "^3.0.8",
    "next": "16.4.3",
    "next-i18next": "^16.4.5",
    "nprogress": "^0.2.0",
    "pino-http": "^11.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.1.9",
    "react-icons": "^5.7.0",
    "react-infinite-scroll-hook": "^6.0.1",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "sortablejs": "^1.15.7",
    "swr": "^2.5.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "autoprefixer": "^10.6.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "standard-version": "^9.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3"
  },
  "resolutions": {
    "@types/react": "^19.3.0",
    "@types/hast": "^3.0.5"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --max-warnings=20",
      "prettier -w"
    ],
    "src/**/*.{json,css,scss,md}": [
      "prettier -w"
    ]
  }
}
